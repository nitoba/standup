{
  "name": "@standup/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "dev:local": "bun --env-file=../../.env.local --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hono/otel": "^1.1.1",
    "@standup/azure-devops": "workspace:*",
    "@standup/config": "workspace:*",
    "@standup/db": "workspace:*",
    "@standup/domain": "workspace:*",
    "@standup/email": "workspace:*",
    "@standup/git-collector": "workspace:*",
    "@standup/logger": "workspace:*",
    "@standup/observability": "workspace:*",
    "@standup/standup-generator": "workspace:*",
    "croner": "^10.0.1",
    "hono": "catalog:"
  }
}

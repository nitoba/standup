{
  "name": "@standup-api",
  "version": "0.0.1",
  "description": "API monolitica em NestJS para standups",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/main.ts",
    "dev:local": "bun --env-file=../../.env.local --watch src/main.ts",
    "build": "nest build",
    "start": "bun --env-file=../../.env src/main.ts",
    "start:local": "bun --env-file=../../.env.local src/main.ts",
    "start:prod": "node dist/main.js",
    "lint": "biome check src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "bunx --bun --env-file=../../.env.local drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env.local run ./src/shared/database/migrate.ts",
    "db:studio": "bunx --bun --env-file=../../.env.local drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.43",
    "@hono/node-server": "^1.19.11",
    "@kiyasov/platform-hono": "^2.0.3",
    "@libsql/client": "^0.17.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/platform-express": "^11.1.16",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.6",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.71.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@opentelemetry/sdk-trace-base": "^2.6.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@scalar/core": "^0.4.3",
    "@scalar/nestjs-api-reference": "^1.1.3",
    "@sixaphone/nestjs-drizzle": "^1.0.1",
    "@thallesp/nestjs-better-auth": "^2.5.1",
    "ai": "^6.0.111",
    "better-auth": "^1.5.5",
    "better-result": "^2.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "croner": "^10.0.1",
    "discord.js": "^14.25.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.7",
    "marked": "^17.0.4",
    "nest-winston": "^1.10.2",
    "nestjs-otel": "^8.0.2",
    "nodemailer": "^8.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.0.1",
    "@types/bun": "^1.3.10",
    "@types/express": "^5.0.0",
    "@types/nodemailer": "^7.0.11",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.0",
    "drizzle-kit": "^0.31.9",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}

{
  "name": "standup-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "@hono/standard-validator": "^0.2.2",
    "hono": "^4.12.5",
    "zod": "^4.3.6"
  },
  "catalogs": {
    "tooling": {
      "@types/bun": "^1.3.10",
      "drizzle-kit": "^0.31.9",
      "typescript": "^5.9.3",
      "vitest": "^4.0.18"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:local": "turbo run dev:local --filter=@standup/api --filter=@standup/worker --filter=@standup/discord-bot",
    "dev:local:api": "bun run --cwd apps/api dev:local",
    "dev:local:worker": "bun run --cwd apps/worker dev:local",
    "dev:local:bot": "bun run --cwd apps/discord-bot dev:local",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "ci": "turbo run lint typecheck test",
    "db:generate": "turbo run db:generate --filter=@standup/db",
    "db:migrate": "turbo run db:migrate --filter=@standup/db",
    "db:studio": "bun run --bun turbo run db:studio --filter=@standup/db"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@types/bun": "catalog:tooling",
    "@vitest/coverage-v8": "^4.0.18",
    "drizzle-kit": "catalog:tooling",
    "turbo": "^2.5.8",
    "typescript": "catalog:tooling",
    "vitest": "catalog:tooling"
  }
}

{
  "name": "@standup/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test src/",
    "db:generate": "bunx --bun --env-file=../../.env.local drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env.local run ./src/migrate.ts",
    "db:studio": "bunx --env-file=../../.env.local drizzle-kit studio"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "@standup/config": "workspace:*",
    "@standup/domain": "workspace:*",
    "@standup/logger": "workspace:*",
    "drizzle-orm": "^0.43.1"
  },
  "devDependencies": {
    "@types/bun": "catalog:tooling",
    "drizzle-kit": "catalog:tooling",
    "typescript": "catalog:tooling"
  }
}

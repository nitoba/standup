# App
NODE_ENV=development
# Turso production example: libsql://your-db-your-org.turso.io
# Turso CLI local example: http://127.0.0.1:8080
# Local SQLite example: file:./data/standup.db
PORT=3333
DATABASE_URL=file:./data/standup.db
DATABASE_AUTH_TOKEN=
INTERNAL_SECRET=change-me-in-production
REPOS_ROOT_PATH=/home/nitoba/Documents/repos/ibs/repos

# Auth (API)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3333

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=

# LLM
AI_PROVIDER_API_KEY=

# Azure DevOps
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_DEFAULT_PROJECT=AGROTRACE

# App URL — used in email links (unsubscribe, deep links). Must be the
# public-facing URL that end-users open in a browser.
APP_URL=http://localhost:4200

# SMTP — all optional; weekly digest is skipped gracefully when absent.
# Local dev: use mailpit (docker-compose already wires worker → mailpit automatically).
# For direct bun run outside Docker, point to the mailpit container on localhost:1025.
# Production: use any real SMTP provider (Gmail, Zoho, Resend, SES, etc.).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Standup Bot <bot@localhost>

# OpenTelemetry (optional — tracing disabled when unset)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Docker Compose host bind mount (optional)
HOST_REPOS_ROOT_PATH=/home/nitoba/Documents/repos/ibs/repos

# Internal communication
BOT_INTERNAL_URL=http://localhost:3334
BOT_INTERNAL_PORT=3334
WORKER_INTERNAL_URL=http://localhost:3335
WORKER_INTERNAL_PORT=3335
API_BASE_URL=http://localhost:3333

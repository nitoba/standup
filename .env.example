# App
NODE_ENV=development
# Turso production example: libsql://your-db-your-org.turso.io
# Turso CLI local example: http://127.0.0.1:8080
# Local SQLite example: file:./data/standup.db
PORT=3333
CORS_ORIGIN=http://localhost:4200
APP_URL=http://localhost:4200
DATABASE_URL=file:./data/standup.db
DATABASE_AUTH_TOKEN=
REPOS_ROOT_PATH=/home/nitoba/Documents/repos/ibs/repos

# Auth (API)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3333

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=
DISCORD_GATEWAY_ENABLED=true

# Scheduler
SCHEDULER_ENABLED=true

# LLM
AI_PROVIDER_API_KEY=

# Azure DevOps
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_DEFAULT_PROJECT=AGROTRACE
AZURE_DEVOPS_PROJECTS=

# SMTP — all optional; weekly digest is skipped gracefully when absent.
# Local dev: use mailpit (docker-compose already wires worker → mailpit automatically).
# For direct bun run outside Docker, point to the mailpit container on localhost:1025.
# Production: use any real SMTP provider (Gmail, Zoho, Resend, SES, etc.).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Standup Bot <bot@localhost>

# OpenTelemetry (optional — tracing disabled when unset)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Docker Compose host bind mounts (optional)
HOST_REPOS_ROOT_PATH=/home/nitoba/Documents/repos/ibs/repos
HOST_SSH_PATH=~/.ssh
